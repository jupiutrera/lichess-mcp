{
  "name": "lichess-mcp",
  "version": "0.1.0",
  "description": "MCP server that gives a coding agent read-only access to public Lichess data: players, games, puzzles, engine evaluations, opening statistics and endgame tablebases.",
  "license": "MIT",
  "author": "jupiutrera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jupiutrera/lichess-mcp.git"
  },
  "type": "module",
  "bin": {
    "lichess-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "eval": "node eval/run.mjs",
    "prepare": "npm run build",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lichess",
    "chess",
    "agents",
    "codex",
    "claude-code"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
